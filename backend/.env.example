# Copy to backend/.env and fill in. .env is gitignored and never committed.
# Every variable below is read once, at startup, by app/core/config.py.

# development | production. Controls whether /docs is served and HSTS is sent.
APP_ENV=development

# Comma-separated browser origins allowed to call this API. No wildcards, ever.
# 5502 is the Live Server port this repo is configured for (.vscode/settings.json).
# In production this is https://www.stonybrookshpe.org (the API itself is deployed at
# api.stonybrookshpe.org so the session cookie stays same-site - see ADR 001).
ALLOWED_ORIGINS=http://127.0.0.1:5502,http://localhost:5502

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Added by the auth slice; not read yet, listed here so the contract is visible ---
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
# SUPABASE_URL=
# Service-role key. Server-side only — this key bypasses row level security.
# SUPABASE_SERVICE_ROLE_KEY=
# Project JWT secret, used to verify the session token in the httpOnly cookie.
# SUPABASE_JWT_SECRET=
